# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
UEFA_DB_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

DAILY_SYNC_HOUR_TASHKENT=9
SYNC_MAX_RETRIES=3
SYNC_RETRY_BACKOFF_SECONDS=30
LOG_LEVEL=INFO

# Optional failure notifications
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Only this administrator chat receives startup, success and failure alerts.
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

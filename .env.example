# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
UEFA_DB_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

SYNC_INTERVAL_MINUTES=5
SYNC_MAX_RETRIES=3
SYNC_RETRY_BACKOFF_SECONDS=30
LOG_LEVEL=INFO

# Optional failure notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
